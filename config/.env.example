# ============================================================
#  API 키 — 이 파일을 복사해서 값을 채우세요
#
#    cp config/.env.example config/.env
#
#  config/.env 는 .gitignore + 커밋훅으로 이중 차단됩니다.
#  채운 뒤 `make doctor` 로 확인하세요. (키는 ***로 가려져 출력됩니다)
# ============================================================


# ── 지금 필요한 것 · 3개 ─────────────────────────────────────

# [1] 공공데이터포털  https://www.data.go.kr
#
#     ★ 이 키 하나로 데이터셋 5종이 전부 열립니다.
#       키는 계정당 1개이고, 데이터셋마다 '활용신청' 버튼만 따로 누르면 됩니다.
#
#       15126466  토지 매매 실거래가       ← 필수   [신청완료]
#       15126470  공장·창고 등 매매        ← 필수   [신청완료]
#       15134761  한국부동산원 부동산통계    ← 권장 (지가변동률)
#       15126465  단독/다가구 매매         ← 선택
#       15126463  상업업무용 매매          ← 선택
#
#     ※ data.go.kr 에 목록만 있고 실제 키는 다른 곳인 것이 둘 있습니다.
#         개별공시지가 (15029071)      → 브이월드 [2]
#         영업소 위치정보 (15076728)   → 한국도로공사 [3]
#
#     ⚠ 마이페이지 → 개발계정 → 일반 인증키에서 **Decoding** 값을 넣으세요.
#       Encoding 값을 넣으면 이중 인코딩되어 인증 오류가 납니다.
DATA_GO_KR_KEY=

# [2] 브이월드  https://www.vworld.kr
#
#     ★ 신청 화면의 '활용 API' 에서 **두 개를 모두** 체크하세요.
#
#       ① 주소검색(지오코더) 2.0   ← 지번을 좌표로. 없으면 IC 거리를 못 잼
#       ② 개별공시지가정보         ← 필지별 단가. 전 필지 baseline (P2-8)
#
#     ⚠ 하나만 신청하면 나중에 다시 신청해야 하고 승인이 또 1~2일 걸립니다.
#       개별공시지가는 data.go.kr 이 아니라 브이월드가 제공합니다.
#
#     서비스 환경 '서버' / 서비스 URL 은 http://localhost
#     ⚠ 승인에 1~2일 걸립니다. 세 개 중 가장 먼저 신청하세요.
VWORLD_KEY=

# [3] 한국도로공사  https://data.ex.co.kr/openapi/apikey/requestKey
#
#     영업소(IC) 위치·좌표와 교통량. 거래를 어느 IC 에 붙일지 정하는 기준점이라
#     사실상 필요합니다. data.go.kr 의 15076728 은 목록만 있고, 실제 발급과
#     호출은 이 포털의 키를 씁니다.
#
#     교통량 받으실 때 이미 발급받으신 키가 있으면 그대로 넣으세요.
#
#     키 없이 가는 우회로도 있습니다 — 영업소 목록을 CSV 로 만들어
#       python -m redt.cli tollgates --path data/raw/tollgate.csv
#     컬럼: unitCode, unitName, xValue, yValue
EX_API_KEY=


# ── 나중에 필요 · 아직 코드가 읽지 않습니다 ──────────────────
#
# P4 에서 회원·매물을 SQLite 에서 Supabase 로 옮길 때 추가됩니다.
# 그 단계에 가면 주석을 풀고 채웁니다. 지금 신청하지 마세요.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=          # 브라우저에 노출되는 값이라 공개돼도 됩니다
# SUPABASE_SERVICE_ROLE_KEY=  # ⚠ 절대 공개 금지. 채팅에도 붙이지 마세요.
