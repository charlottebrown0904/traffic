# [3] 한국도로공사  https://data.ex.co.kr/openapi/apikey/requestKey
#
#     선택입니다. 비워두셔도 수집은 진행됩니다.
#     영업소 좌표는 위 15076728 로 대체되고, 이 키는 과거 교통량 조회가
#     가능한지 판정할 때(P2-3) 필요합니다.
#     교통량 받으실 때 이미 발급받으신 키가 있으면 그대로 넣으세요.
EX_API_KEY=


# ── 나중에 필요 · 아직 코드가 읽지 않습니다 ──────────────────
#
# P4 에서 회원·매물을 SQLite 에서 Supabase 로 옮길 때 추가됩니다.
# 그 단계에 가면 주석을 풀고 채웁니다. 지금 신청하지 마세요.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=          # 브라우저에 노출되는 값이라 공개돼도 됩니다
# SUPABASE_SERVICE_ROLE_KEY=  # ⚠ 절대 공개 금지. 채팅에도 붙이지 마세요.
